{
  "name": "postsoma-root",
  "version": "0.1.0",
  "private": true,
  "description": "Root workspace proxy for PostSoma DevLibrary",
  "scripts": {
    "dev": "npm --prefix postsoma-devlibrary run dev",
    "build": "npm --prefix postsoma-devlibrary run build",
    "start": "npm --prefix postsoma-devlibrary run start",
    "lint": "npm --prefix postsoma-devlibrary run lint",
    "test": "npm --prefix postsoma-devlibrary run test",
    "test:watch": "npm --prefix postsoma-devlibrary run test:watch",
    "pipeline:generate": "npm --prefix postsoma-devlibrary run pipeline:generate",
    "verify:three-layers": "npm --prefix postsoma-devlibrary run verify:three-layers",
    "typecheck": "npm --prefix postsoma-devlibrary run typecheck",
    "install:app": "npm --prefix postsoma-devlibrary install"
  }
}
