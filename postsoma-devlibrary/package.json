{
  "name": "postsoma-devlibrary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run github:validate-curation",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepipeline:generate": "npm run github:validate-curation -- --allow-canonical-favorites-missing-from-resources",
    "pipeline:generate": "tsx scripts/pipeline/generateResources.ts",
    "postpipeline:generate": "npm run github:validate-curation",
    "github:migrate": "tsx scripts/github/migrateGithubFavorites.ts",
    "postgithub:migrate": "npm run github:validate-curation",
    "github:add": "tsx scripts/github/manageGithubFavorites.ts add",
    "github:review": "tsx scripts/github/manageGithubFavorites.ts review",
    "github:health": "tsx scripts/github/checkGithubHealth.ts",
    "github:health:dry-run": "node --env-file-if-exists=.env.github-health.local --import tsx scripts/github/checkGithubHealth.ts --dry-run",
    "github:validate-curation": "tsx scripts/github/validateGithubCuration.ts"
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "minisearch": "^7.1.0",
    "next": "14.2.3",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.11.0",
    "typescript": "^5",
    "vitest": "^1.6.0"
  }
}
